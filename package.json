{
  "name": "cuonztech-agent-harness",
  "version": "0.3.1",
  "description": "MCP-Server zur Härtung autonomer KI-Agenten — simulierte F1-F5-Chaos-Szenarien, Idempotenz-Prüfung, Ghost-Write-Erkennung, striktes Key-genaues State-Diffing, Resilience Score, automatische System-Prompt-Reparatur und ein transparenter Chaos-Proxy vor einem echten Upstream-MCP-Server.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cuonztech-harness": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "benchmark": "node dist/index.js benchmark",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "agent-testing",
    "chaos-engineering",
    "idempotency",
    "llm-agents",
    "ghost-write",
    "resilience",
    "cuonztech"
  ],
  "author": "CuonzTech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuonztech/agent-harness.git"
  },
  "homepage": "https://github.com/cuonztech/agent-harness#readme",
  "bugs": {
    "url": "https://github.com/cuonztech/agent-harness/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
